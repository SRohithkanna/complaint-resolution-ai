# Copy to .env and fill in. NEVER commit .env to git.
# Use a dedicated Gmail account with 2-step verification ON and an App Password
# (Google Account -> Security -> App passwords). Do not use your normal password.
IMAP_HOST=imap.gmail.com
IMAP_USER=yourproject@gmail.com
IMAP_PASSWORD=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
POLL_SECONDS=30
UPLOAD_DIR=./uploads

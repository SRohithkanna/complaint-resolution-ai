# PostgreSQL backend
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/complaint_resolution

# Email ingestion — use a dedicated Gmail account
IMAP_HOST=imap.gmail.com
IMAP_USER=yourproject@gmail.com
IMAP_PASSWORD=your-16-char-app-password

# Email forwarding
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Ingestion settings
POLL_SECONDS=30
UPLOAD_DIR=./uploads